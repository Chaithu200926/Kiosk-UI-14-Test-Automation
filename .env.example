# Copy to .env and fill in. Never commit .env.

# Kiosk app to test (default: the new build under ProgramData).
# KIOSK_APP_PATH=C:\ProgramData\KNCC\CinescapeKioskNew14\CinescapeKiosk.exe

# Mobile number of the test customer (checkout and club card payment).
KIOSK_TEST_MOBILE=

# Test customer for sign-in / club card tests: login email, password, OTP and club card number.
KIOSK_TEST_USERNAME=
KIOSK_TEST_PASSWORD=
KIOSK_TEST_OTP=
KIOSK_TEST_CLUB_CARD=
# Code that confirms the wallet customer when paying (build New14 emails a 6-digit code). The paying tests are
# skipped until UAT has a fixed code for the test customer.
# KIOSK_WALLET_CODE=
# Optional: mailbox KUI-17 emails the tickets to (default: KIOSK_TEST_USERNAME).
# KIOSK_TEST_EMAIL=

# Admin PIN of the test kiosk (KUI-22).
KIOSK_ADMIN_PIN=

# Optional: ports and video.
# APPIUM_PORT=4723
# KIOSK_RECORDER_PORT=8899
# FFMPEG_DIR=C:\Users\<you>\AppData\Local\ffmpeg\bin
# KIOSK_VIDEO_FPS=10
